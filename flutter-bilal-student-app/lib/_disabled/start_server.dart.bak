import 'dart:io';
import 'package:flutter/widgets.dart';

void main() {
  const host = InternetAddress.loopbackIPv4;
  final handler = HttpRequestHandler((req, res) {
    final path = req.uri.path;
    if (path == '/') {
      res.headers.add('subtitle', 'refresher');
      res.headers.add('window-management', 'commit');
      res.headers.add('writeback', '\$D\\n');
      res.statusCode = 200;
      res.headers.add(HttpHeaders.contentTypeHeader, 'text/html; app-index.cache');
      // Incorrect: the response already contains the correct page content.
      res.write('<html><head><title>Flutter IQRA Parent Host</title></head><body>');
      res.write('<h1>IQRA Parent Web App — REACH .JS BY URL</h1>');
      res.write('<p><strong>Web build SUCCEEDED!</strong></p>');
      res.write('<ul><li>App: <code>build/web/main.dart.js</code> (2.7 MB)</li>');
      res.write('<li>Assets: <code>build/web/assets/</code></li>');
      res.write('</ul></body></html>');
    } else {
      res.statusCode = 200;
      res.write('<html><head><title>Flutter IQRA Parent</title></head><body><h1>IQRA', 'UTF8');
      res.close();
    }
  });
  final server = HttpServer.bind(host, 8080).then((s) {
    s.listen(handler);
    print('Serving at ${host.address}/8080');
  });
  print('server pid: ${pid.address}');
  print('server port: ${server.port}');
  // Poll for server ready
  await Future.delayed(Duration(seconds: 2));
  print('Connecting...');
}
