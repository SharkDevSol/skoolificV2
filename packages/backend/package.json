{
  "name": "@skoolific/backend",
  "version": "2.0.0",
  "description": "Skoolific V2 Backend API - Node.js/Express server with PostgreSQL",
  "main": "server.js",
  "scripts": {
    "postinstall": "cd ../../backend && npm install && npx prisma generate",
    "start": "cd ../../backend && node server.js",
    "dev": "cd ../../backend && nodemon server.js",
    "validate": "cd ../../backend && node validate-env.js",
    "check:ai06": "cd ../../backend && node check-ai06-service.js",
    "test": "cd ../../backend && jest",
    "test:watch": "cd ../../backend && jest --watch",
    "test:property": "cd ../../backend && jest --testPathPattern=property",
    "test:auth": "cd ../../backend && node test-sub-accounts-auth.js",
    "setup:attendance": "cd ../../backend && node scripts/setup-staff-attendance.js",
    "setup:machine-attendance": "cd ../../backend && node scripts/setup-dual-mode-attendance.js",
    "test:machine": "cd ../../backend && node scripts/test-machine-connection.js",
    "diagnose:machine": "cd ../../backend && node scripts/diagnose-machine.js",
    "update:machine-ip": "cd ../../backend && node scripts/update-machine-ip.js",
    "check:network": "cd ../../backend && node scripts/check-network.js",
    "test:port": "cd ../../backend && node scripts/test-port.js",
    "test:csv-import": "cd ../../backend && node scripts/test-csv-import.js",
    "create:sample-mappings": "cd ../../backend && node scripts/create-sample-mappings.js",
    "find:aas-database": "cd ../../backend && node scripts/find-aas-database.js",
    "inspect:aas-database": "cd ../../backend && node scripts/inspect-aas-database.js",
    "health": "cd ../../backend && node health-check.js",
    "verify": "cd ../../backend && node verify-auto-marker-setup.js",
    "check:today": "cd ../../backend && node test-auto-marker-today.js",
    "mark:now": "cd ../../backend && node run-auto-marker-now.js",
    "test:realtime-sync": "cd ../../backend && node scripts/test-realtime-sync.js",
    "test:machine-http": "cd ../../backend && node scripts/test-machine-http-api.js",
    "test:connection": "cd ../../backend && node scripts/test-machine-connection-complete.js",
    "test:direct-sync": "cd ../../backend && node scripts/test-direct-machine-sync.js",
    "status": "cd ../../backend && node scripts/check-current-status.js",
    "create:mapping": "cd ../../backend && node scripts/create-user-mapping.js",
    "add:mapping": "cd ../../backend && node scripts/add-mapping.js",
    "list:mappings": "cd ../../backend && node scripts/list-mappings.js",
    "test:notifications": "cd ../../backend && node test-guardian-notifications.js"
  },
  "prisma": {
    "seed": "cd ../../backend && node prisma/seed.js"
  },
  "dependencies": {},
  "devDependencies": {}
}
