{
  "name": "school-management-backend",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "validate": "node validate-env.js",
    "check:ai06": "node check-ai06-service.js",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:property": "jest --testPathPattern=property",
    "test:auth": "node test-sub-accounts-auth.js",
    "setup:attendance": "node scripts/setup-staff-attendance.js",
    "setup:machine-attendance": "node scripts/setup-dual-mode-attendance.js",
    "test:machine": "node scripts/test-machine-connection.js",
    "diagnose:machine": "node scripts/diagnose-machine.js",
    "update:machine-ip": "node scripts/update-machine-ip.js",
    "check:network": "node scripts/check-network.js",
    "test:port": "node scripts/test-port.js",
    "test:csv-import": "node scripts/test-csv-import.js",
    "create:sample-mappings": "node scripts/create-sample-mappings.js",
    "find:aas-database": "node scripts/find-aas-database.js",
    "inspect:aas-database": "node scripts/inspect-aas-database.js",
    "health": "node health-check.js",
    "verify": "node verify-auto-marker-setup.js",
    "check:today": "node test-auto-marker-today.js",
    "mark:now": "node run-auto-marker-now.js",
    "test:realtime-sync": "node scripts/test-realtime-sync.js",
    "test:machine-http": "node scripts/test-machine-http-api.js",
    "test:connection": "node scripts/test-machine-connection-complete.js",
    "test:direct-sync": "node scripts/test-direct-machine-sync.js",
    "status": "node scripts/check-current-status.js",
    "create:mapping": "node scripts/create-user-mapping.js",
    "add:mapping": "node scripts/add-mapping.js",
    "list:mappings": "node scripts/list-mappings.js",
    "test:notifications": "node test-guardian-notifications.js",
    "migrate": "node database/migrate.js up",
    "migrate:down": "node database/migrate.js down",
    "migrate:status": "node database/migrate.js status",
    "migrate:create": "node database/migrate.js create",
    "migrate:test": "node database/test-migrations.js",
    "perf:sample": "k6 run performance-tests/tests/sample-test.js",
    "perf:dashboard": "k6 run performance-tests/tests/dashboard-load-test.js",
    "perf:marks": "k6 run performance-tests/tests/mark-entry-load-test.js",
    "perf:exams": "k6 run performance-tests/tests/exam-taking-load-test.js",
    "perf:registration": "k6 run performance-tests/tests/student-registration-load-test.js",
    "perf:all": "npm run perf:sample && npm run perf:dashboard && npm run perf:marks"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.16.2",
    "@tanstack/react-query": "^5.100.9",
    "africastalking": "^0.7.9",
    "axios": "^1.13.4",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.2",
    "ethiopian-calendar-date-converter": "^2.1.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.8.0",
    "generate": "^0.14.0",
    "helmet": "^8.1.0",
    "init": "^0.1.2",
    "ioredis": "^5.10.1",
    "isomorphic-dompurify": "^3.12.0",
    "jsonwebtoken": "^9.0.2",
    "mdb-reader": "^3.1.0",
    "multer": "^2.0.1",
    "node-telegram-bot-api": "^0.67.0",
    "node-zklib": "^1.3.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "uuid": "^13.0.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
    "zklib": "^0.2.11",
    "zklib-js": "^1.3.5"
  },
  "devDependencies": {
    "fast-check": "^4.4.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.16.2"
  }
}
