# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/skoolific?schema=school_comms&timezone=Africa/Addis_Ababa"
DB_NAME=skoolific
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# JWT Configuration
# IMPORTANT: Generate a strong random secret for production!
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64').replace(/[^a-zA-Z0-9]/g, ''))"
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=5052
FRONTEND_URL=http://localhost:5173

# Security
NODE_ENV=development
HTTPS_ENABLED=false

# AI06 Biometric Device Configuration (Optional)
AI06_WEBSOCKET_ENABLED=false
AI06_WEBSOCKET_PORT=7700
AI06_DEVICE_IP=192.168.1.2
AI06_DEVICE_PORT=80

# Email Configuration for Guardian Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram Bot Configuration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# SMS Gateway Configuration (Optional)
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://sms-gateway.example.com/api

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
