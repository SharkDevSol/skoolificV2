{
  "name": "skoolific-v2",
  "version": "2.0.0",
  "description": "Skoolific V2 - Multi-platform school management system with native desktop and mobile applications",
  "private": true,
  "workspaces": [
    "packages/backend",
    "packages/frontend",
    "packages/desktop",
    "packages/mobile-staff",
    "packages/mobile-student",
    "packages/mobile-guardian",
    "packages/mobile-super-admin"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "start:backend": "npm run start --workspace=packages/backend",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "build:desktop": "npm run build --workspace=packages/desktop",
    "build:mobile-staff": "npm run build --workspace=packages/mobile-staff",
    "build:mobile-student": "npm run build --workspace=packages/mobile-student",
    "build:mobile-guardian": "npm run build --workspace=packages/mobile-guardian",
    "build:mobile-super-admin": "npm run build --workspace=packages/mobile-super-admin",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css}\"",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "keywords": [
    "school-management",
    "education",
    "ethiopia",
    "tauri",
    "capacitor",
    "react",
    "nodejs"
  ],
  "author": "Skoolific Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^10.2.1",
    "prettier": "^3.8.3"
  }
}
