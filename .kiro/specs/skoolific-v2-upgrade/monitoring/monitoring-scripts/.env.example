# Skoolific V2 Monitoring Scripts Configuration
# Copy this file to .env and fill in the actual values

# Backend API Configuration
BACKEND_URL=http://localhost:3000
# For production: BACKEND_URL=http://[school-server-ip]:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
# Database name will be constructed as: skoolific_[branch_code]

# Monitoring Configuration
LOG_LEVEL=info
# Options: debug, info, warn, error

# Alert Thresholds
CPU_THRESHOLD=80
MEMORY_THRESHOLD=80
DISK_THRESHOLD=85
API_RESPONSE_THRESHOLD=500
# All thresholds in percentage except API_RESPONSE_THRESHOLD (in milliseconds)

# Notification Configuration (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# Email Alerts (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=monitoring@school.com
